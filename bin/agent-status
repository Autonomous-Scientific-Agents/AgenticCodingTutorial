#!/bin/bash
# Model access and GitHub at a glance. The container shows the summary when an interactive shell starts.
#
#   agent-status           one line from variables and files only, so it adds no delay
#   agent-status --check   ask MAG and ALCF whether your tokens work (never prints them)
#   agent-status --models  list the models MAG and ALCF offer you; ALCF models show whether they are hot
#   agent-status --hot     list only the ALCF models that are loaded and answer right away
set -uo pipefail
source "$(dirname "$(readlink -f "$0")")/agent-tokens.sh"

summary() {
  local mag alcf gh
  if [[ -n "${AMSC_TOKEN:-}" ]]; then
    mag="MAG ready (claude-amsc, codex-amsc, opencode-amsc)"
  else
    mag="MAG: no AMSC_TOKEN (the *-amsc commands ask for a PAT)"
  fi
  if [[ -n "${ALCF_AI_TOKEN:-}" ]] || compgen -G "$HOME/.globus/app/*/alcf_tokens/tokens.json" >/dev/null; then
    alcf="ALCF ready (claude-alcf, codex-alcf, opencode-alcf)"
  else
    alcf="ALCF: not logged in (the *-alcf commands walk you through it)"
  fi
  if [[ -n "${GH_TOKEN:-}" || -s "$HOME/.config/gh/hosts.yml" ]]; then
    gh="GitHub ready"
  else
    gh="GitHub: run gh auth login"
  fi
  echo "$mag · $alcf · $gh"
}

# One line for a token check; returns 1 unless the service accepted the token.
report() {
  local label="$1" status="$2" fix="$3"
  case "$status" in
    200) echo "$label: valid"; return 0 ;;
    401|403) echo "$label: rejected (HTTP $status), expired or invalid. $fix" ;;
    000) echo "$label: no answer (network, proxy or service down)" ;;
    *) echo "$label: unexpected answer (HTTP $status)" ;;
  esac
  return 1
}

check() {
  local rc=0 token
  if [[ -n "${AMSC_TOKEN:-}" ]]; then
    report "MAG (AMSC_TOKEN)" "$(_mag_check "$AMSC_TOKEN")" "Renew: create a new PAT, then: read -rs AMSC_TOKEN && export AMSC_TOKEN" || rc=1
  else
    echo "MAG: no AMSC_TOKEN (the *-amsc commands ask for a PAT)"
  fi
  if [[ -n "${ALCF_AI_TOKEN:-}" ]]; then
    report "ALCF (ALCF_AI_TOKEN, from the host)" "$(_alcf_check "$ALCF_AI_TOKEN")" \
      "The *-alcf commands fall back to the alcf-tokens login." || rc=1
  fi
  if command -v alcf-tokens >/dev/null 2>&1; then
    if token="$(alcf-tokens get-token inference </dev/null 2>/dev/null)" && [[ -n "$token" ]]; then
      report "ALCF (alcf-tokens login)" "$(_alcf_check "$token")" "Renew: alcf-tokens login inference" || rc=1
    else
      echo "ALCF (alcf-tokens login): not logged in. Log in: alcf-tokens login inference"
    fi
  elif [[ -z "${ALCF_AI_TOKEN:-}" ]]; then
    echo "ALCF: not set up (install alcf-tokens: uv tool install alcf-tokens)"
  fi
  return "$rc"
}

# MAG answers /v1/models in the OpenAI format: {"data": [{"id": ...}, ...]}.
MAG_MODELS_PY='
import json, sys
try:
    models = sorted(m["id"] for m in json.load(sys.stdin).get("data") or [])
except (ValueError, KeyError, TypeError, AttributeError):
    sys.exit("MAG: unexpected answer to /v1/models (not a model list)")
print("MAG:")
for model in models:
    print("  " + model)
'

# ALCF: list-endpoints names the clusters, frameworks and models; <cluster>/jobs says which models are running
# (hot, or still starting) or queued. Offline models load when someone sends a request, which can take minutes.
ALCF_MODELS_PY='
import json, os, re, sys
folder, mode = sys.argv[1], sys.argv[2]
def load(name):
    try:
        with open(os.path.join(folder, name)) as f:
            return json.load(f)
    except (IOError, ValueError):
        return None
rank = {"hot": 0, "starting": 1, "queued": 2, "offline": 3, "unknown": 4}
def names(value):
    items = value if isinstance(value, list) else str(value or "").split(",")
    return [str(m).strip() for m in items if str(m).strip()]
def table(value):
    return value if isinstance(value, dict) else {}
endpoints = load("endpoints.json")
clusters = endpoints.get("clusters") if isinstance(endpoints, dict) else None
# "clusters" prints the names for the shell to fetch <cluster>/jobs; it stays quiet, the listing reports errors.
if mode == "clusters":
    print(" ".join(c for c in table(clusters) if re.match(r"^[A-Za-z0-9_-]+$", c)))
    sys.exit()
if not isinstance(clusters, dict):
    sys.exit("ALCF: unexpected answer to list-endpoints (no cluster list)")
print("ALCF (hot: loaded now; starting or queued: loading; offline: loads on the first request, which can take minutes; unknown: no live status):")
for cluster in sorted(clusters):
    jobs = load("jobs-" + cluster + ".json")
    known = isinstance(jobs, dict)
    # Keyed by (framework, model); a job that names no framework counts for every framework.
    state = {}
    for key in ("running", "queued"):
        for job in (jobs if known else {}).get(key) or []:
            if not isinstance(job, dict):
                continue
            status = "queued"
            if key == "running":
                ready = str(job.get("Model Status") or "").lower()
                status = "hot" if ready in ("ready", "running", "live") else "starting"
            framework = str(job.get("Framework") or "").lower()
            for model in names(job.get("Models")):
                if rank[status] < rank[state.get((framework, model), "offline")]:
                    state[(framework, model)] = status
    note = "" if known else ", live status unavailable"
    for framework, info in sorted(table(table(clusters[cluster]).get("frameworks")).items()):
        def status_of(m):
            if not known:
                return "unknown"
            return min(state.get((framework.lower(), m), "offline"), state.get(("", m), "offline"), key=rank.get)
        models = sorted(set(table(info).get("models") or []), key=lambda m: (rank[status_of(m)], m.lower()))
        hot = [m for m in models if status_of(m) == "hot"]
        if mode == "hot":
            print("%s (%s): %d hot%s" % (cluster, framework, len(hot), note))
            models = hot
        else:
            print("%s (%s): %d model%s, %d hot%s" % (cluster, framework, len(models), "" if len(models) == 1 else "s", len(hot), note))
        for model in models:
            print("  %-8s  %s" % (status_of(model), model))
'

# List models. "all" covers MAG and ALCF; "hot" shows only the ALCF models that are loaded now.
# The ( ) body runs in a subshell, so the trap still sees $folder and removes it on any exit.
models() (
  local which="$1" folder status token cluster rc=0
  if ! command -v python3 >/dev/null 2>&1; then
    echo "$_cmd: listing models needs python3" >&2
    return 1
  fi
  folder="$(mktemp -d)" || return 1
  trap 'rm -rf "$folder"' EXIT
  if [[ "$which" == all ]]; then
    if [[ -z "${AMSC_TOKEN:-}" ]]; then
      echo "MAG: no AMSC_TOKEN (the *-amsc commands ask for a PAT)"
    elif status="$(_http_status "$AMSC_TOKEN" "$MAG_URL/v1/models" "$folder/mag.json")" && [[ "$status" == 200 ]]; then
      python3 -c "$MAG_MODELS_PY" < "$folder/mag.json" || rc=1
    else
      report "MAG (AMSC_TOKEN)" "$status" "Renew: create a new PAT, then: read -rs AMSC_TOKEN && export AMSC_TOKEN" || rc=1
    fi
  fi
  # Like the *-alcf commands: the token from the host while ALCF accepts it, else the alcf-tokens login.
  token="${ALCF_AI_TOKEN:-}"
  [[ -n "$token" ]] && status="$(_http_status "$token" "$ALCF_URL/list-endpoints" "$folder/endpoints.json")"
  if [[ -z "$token" || "$status" =~ ^40[13]$ ]] && _alcf_get_token; then
    token="$ALCF_AI_TOKEN"
    status="$(_http_status "$token" "$ALCF_URL/list-endpoints" "$folder/endpoints.json")"
  fi
  if [[ -z "$token" ]] && ! command -v alcf-tokens >/dev/null 2>&1; then
    echo "ALCF: not set up (install alcf-tokens: uv tool install alcf-tokens)"
    return 1
  elif [[ -z "$token" ]]; then
    echo "ALCF: not logged in. Log in: alcf-tokens login inference"
    return 1
  elif [[ "$status" != 200 ]]; then
    report "ALCF" "$status" "Renew: alcf-tokens login inference"
    return 1
  fi
  for cluster in $(python3 -c "$ALCF_MODELS_PY" "$folder" clusters); do
    # All clusters at once, so a slow service costs one timeout rather than one per cluster.
    { [[ "$(_http_status "$token" "$ALCF_URL/$cluster/jobs" "$folder/jobs-$cluster.json")" == 200 ]] ||
      rm -f "$folder/jobs-$cluster.json"; } &
  done
  wait
  python3 -c "$ALCF_MODELS_PY" "$folder" "$which" || rc=1
  return "$rc"
)

case "${1:-}" in
  "") summary ;;
  --check) check ;;
  --models) models all ;;
  --hot) models hot ;;
  -h|--help) sed -n '2,7s/^# \{0,1\}//p' "$0" ;;
  *) echo "usage: $_cmd [--check | --models | --hot]" >&2; exit 2 ;;
esac
